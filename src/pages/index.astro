---
import RootLayout from "~layouts/RootLayout.astro";
import HeroSection from "~components/home/HeroSection.astro";
import HomeHeroCopyMotion from "~components/home/HomeHeroCopyMotion.tsx";
import BuilderArtifact from "~components/home/artifacts/BuilderArtifact.tsx";
import CreatorArtifact from "~components/home/artifacts/CreatorArtifact.tsx";
import EducatorArtifact from "~components/home/artifacts/EducatorArtifact.tsx";
import HomeClosingIndex from "~components/home/HomeClosingIndex.tsx";
import HomeFooter from "~components/home/HomeFooter.astro";
import HomeOverscrollPainting from "~components/home/HomeOverscrollPainting.tsx";
import HomeOverscrollReveal from "~components/home/HomeOverscrollReveal.tsx";
import HomeBandHashScroll from "~components/home/HomeBandHashScroll.tsx";
import HomeSplashOverlay from "~components/home/HomeSplashOverlay.tsx";
import { description, title } from "~shared";
import PreloadHomeHeroGlbs from "~components/home/artifacts/PreloadHomeHeroGlbs.tsx";
---

<RootLayout head={{ title, description }}>
  <h1 class="sr-only">Krish Gupta</h1>
  <HomeOverscrollPainting client:load />
  <HomeOverscrollReveal client:load />
  <HomeBandHashScroll client:load />
  <PreloadHomeHeroGlbs client:load />
  <HomeHeroCopyMotion client:load />
  <div class="home-scroll-surface flex flex-col w-full">
    <input
      type="file"
      id="portrait-file"
      accept="image/*"
      class="home-file-input"
      tabindex="-1"
      aria-hidden="true"
    />
    <input
      type="file"
      id="audio-file"
      accept="audio/*"
      multiple
      class="home-file-input"
      tabindex="-1"
      aria-hidden="true"
    />

    <HeroSection
      id="builder"
      heading="builder"
      subtext="Making and hacking. Dabbling with the frontier."
      accent="builder"
      ctaLabel="the makerhouse →"
      ctaHref="/building"
    >
      <BuilderArtifact slot="artifact" client:visible />
    </HeroSection>

    <HeroSection
      id="creator"
      heading="creator"
      subtext="Leaving a poetic imprint."
      accent="creator"
      ctaLabel="the atelier →"
      ctaHref="/creating"
      artifactFirst
    >
      <CreatorArtifact slot="artifact" client:load />
    </HeroSection>

    <HeroSection
      id="educator"
      heading="educator"
      subtext="Presenting talks, workshops, articles and more."
      accent="educator"
      ctaLabel="the library →"
      ctaHref="/educating"
      clipOverflow={false}
    >
      <EducatorArtifact slot="artifact" client:load />
    </HeroSection>

    <div class="home-closing-tail">
      <HomeSplashOverlay client:load />
      <HomeClosingIndex client:load />
      <HomeFooter />
    </div>
  </div>
</RootLayout>

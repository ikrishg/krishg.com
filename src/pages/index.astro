---
import RootLayout from "~layouts/RootLayout.astro";
import HeroSection from "~components/home/HeroSection.astro";
import HomeFooter from "~components/home/HomeFooter.astro";
import HomeHeroCopyMotion from "~components/home/HomeHeroCopyMotion.tsx";
import BuilderArtifact from "~components/home/artifacts/BuilderArtifact.tsx";
import CreatorArtifact from "~components/home/artifacts/CreatorArtifact.tsx";
import EducatorArtifact from "~components/home/artifacts/EducatorArtifact.tsx";
import { description, title } from "~shared";
import PreloadHomeHeroGlbs from "~components/home/artifacts/PreloadHomeHeroGlbs.tsx";
---

<RootLayout head={{ title, description }} homeNav>
  <h1 class="sr-only">Krish Gupta</h1>
  <PreloadHomeHeroGlbs client:load />
  <HomeHeroCopyMotion client:load />
  <div class="flex flex-col w-full">
    <input
      type="file"
      id="portrait-file"
      accept="image/*"
      class="home-file-input"
      tabindex="-1"
      aria-hidden="true"
    />
    <input
      type="file"
      id="audio-file"
      accept="audio/*"
      multiple
      class="home-file-input"
      tabindex="-1"
      aria-hidden="true"
    />

    <HeroSection
      id="builder"
      heading="builder"
      subtext="Making and hacking. Dabbling with the frontier."
      accent="builder"
      ctaLabel="the makerhouse →"
      ctaHref="/building"
    >
      <BuilderArtifact slot="artifact" client:load />
    </HeroSection>

    <HeroSection
      id="creator"
      heading="creator"
      subtext="Leaving a poetic imprint."
      accent="creator"
      ctaLabel="the atelier →"
      ctaHref="/creating"
      artifactFirst
    >
      <CreatorArtifact slot="artifact" client:visible />
    </HeroSection>

    <HeroSection
      id="educator"
      heading="educator"
      subtext="Presenting talks, workshops, articles and more."
      accent="educator"
      ctaLabel="the library →"
      ctaHref="/educating"
    >
      <EducatorArtifact slot="artifact" client:visible />
    </HeroSection>

    <HomeFooter />
  </div>
</RootLayout>

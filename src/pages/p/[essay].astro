---
import { getCollection, render } from "astro:content";
import RootLayout from "~layouts/RootLayout.astro";
import { formatDate } from "~lib/utils";
import { site, socials } from "~shared";

export async function getStaticPaths() {
  const essays = await getCollection("essays");

  return essays.map((essay) => ({
    params: { essay: essay.id },
    props: { essay: essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---

<RootLayout
  head={{
    title: essay.data.title + " | Krish Gupta",
    description: essay.data.description,
    ogp: {
      type: "article",
      image: essay.data.cover,
      article: {
        publishedTime: essay.data.date.toISOString(),
        modifiedTime: essay.data.date.toISOString(),
        tags: essay.data.tags ?? [],
      },
    },
    canonical: essay.data.canonical,
  }}
  hideTemplate={true}
>
  <article
    class:list={[
      "my-8",
      "font-serif",
      "prose prose-essay",
      "prose-headings:text-black text-foreground",
      "prose-headings:font-semibold",
      "mx-auto px-8",
      "prose-a:underline prose-a:underline-offset-8",
      "leading-loose wrap-break-word text-justify",
    ]}
  >
    <header class="not-prose mb-4 text-sm">
      <nav>
        <a href={new URL("/", site)} class="underline">home</a>{" "}
        /
        <a href={new URL("/essays", site)} class="underline">essays</a>{" "}
        /
        <span class="text-sm text-foreground">{essay.id}</span>
      </nav>
    </header>
    <div class="mb-4 text-sm text-foreground">
      <span>
        {formatDate(essay.data.date)}
      </span>
    </div>
    <hr class="border-foreground/50 mt-0! mb-8!" />
    <h1>{essay.data.title}</h1>
    <Content />
    <hr class="border-foreground/50 my-8!" />
    <footer class="text-sm font-semibold space-y-6">
      {
        essay.data.canonical && (
          <div>
            <a href={essay.data.canonical} class="underline" target="_blank">
              originally published on {new URL(essay.data.canonical).hostname}
            </a>
          </div>
        )
      }
      <div class="flex flex-wrap gap-2 items-center justify-between">
        <span
          >© {new Date().getFullYear()}{" "}
          <a href={socials.x} class="underline" target="_blank"
            >@{new URL(socials.x).pathname.replace("/", "")}</a
          ></span
        >
        <a href={new URL("/essays", site)} class="underline">other essays</a>
      </div>
    </footer>
  </article>
</RootLayout>

---
import "~styles/global.css";
import Head, { type HeadProps } from "~components/Head.astro";
import HomeNavbar from "~components/home/HomeNavbar.astro";
import HomePageLoader from "~components/home/HomePageLoader.tsx";
import HomeReadySignal from "~components/home/HomeReadySignal.tsx";
import type { HeroAccent } from "~components/home/hero-types";
import { homeAccentCanvasHex } from "~components/home/hero-types";

export interface Props {
  head?: Partial<HeadProps>;
  hideTemplate?: boolean;
  /** Homepage navbar (logo + search) with per-band colour. */
  homeNav?: boolean;
  /** Fixed accent for stub pages (full-page colour + navbar). */
  pageAccent?: HeroAccent;
  class?: string;
}

const {
  head,
  hideTemplate,
  homeNav = true,
  pageAccent,
  class: className,
} = Astro.props;

/** Homepage scrolls accents; stubs pin one. Default builder before hydrate. */
const htmlAccent = pageAccent ?? (homeNav && !hideTemplate ? "builder" : undefined);
const themeColor = htmlAccent
  ? homeAccentCanvasHex[htmlAccent]
  : homeAccentCanvasHex.builder;
---

<!doctype html>
<html lang="en" data-page-accent={htmlAccent}>
  <Head {...head} homeNav={homeNav} themeColor={themeColor} />
  <script
    is:inline
    define:vars={{
      hasLoader: !hideTemplate,
      seedIntro: Boolean(homeNav && !hideTemplate),
    }}
  >
    (() => {
      try {
        const root = document.documentElement;
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root.dataset.motionEnhance = "1";
        }
        /* Seed before React hydrates so copy reveal cannot win the race. */
        if (hasLoader) {
          let played = false;
          try {
            played = sessionStorage.getItem("krishg:intro-played") === "1";
            if (!played) sessionStorage.setItem("krishg:intro-played", "1");
          } catch {
            /* storage blocked: play the intro */
          }
          if (played) {
            root.dataset.introSkip = "1";
            root.dataset.introPhase = "ready";
          } else if (seedIntro) {
            root.dataset.logoMorph = "pending";
            root.dataset.introPhase = "draw";
          }
        }
      } catch {
        /* ignore */
      }
    })();
  </script>
  <body
    class="site-body m-0 font-[family-name:var(--font-space-grotesk),system-ui,sans-serif] text-[#252d45] [font-feature-settings:'ss01'_on] overscroll-y-none"
  >
    {/* Safari 26 Liquid Glass bottom-toolbar sample target; see global.css */}
    <div class="safari-toolbar-tint" aria-hidden="true"></div>
    {!hideTemplate && (
      <>
        <HomePageLoader client:load />
        <HomeReadySignal client:load />
        <HomeNavbar />
      </>
    )}
    <main class:list={["flex-1 w-full overflow-x-clip", className]}>
      <slot />
    </main>
  </body>
</html>

---
import { Font } from "astro:assets";
import type { ImageMetadata } from "astro";
import DefaultOpenGraphImage from "~assets/og-image.webp";
import { getPersonSchema } from "~lib/person-schema";
import * as shared from "~shared";

export interface HeadProps {
  title: string;
  description: string;
  ogp: {
    type: "website";
    image: ImageMetadata;
  };
  canonical: string | undefined;
}

export type Props = Partial<HeadProps> & {
  /** Browser chrome / theme-color; kept in sync with html[data-page-accent]. */
  themeColor?: string;
};

const siteName = shared.title;
const siteUrl = shared.site;

const defaultProps = {
  title: siteName,
  description: shared.description,
  ogp: {
    type: "website" as const,
    image: DefaultOpenGraphImage,
  },
} as HeadProps;

const props = Astro.props;
const themeColor = Astro.props.themeColor ?? "#398fd0";

const { title, description } = { ...defaultProps, ...props };
const ogp = { ...defaultProps.ogp, ...props.ogp };
const { type, image } = ogp;
const canonicalHref = props.canonical
  ? String(props.canonical)
  : Astro.url.href;
const personSchema = getPersonSchema(siteUrl.href);
const xHandle = new URL(shared.socials.x).pathname.replace(/^\//, "");
---

<meta charset="utf-8" />
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
/>
<meta name="theme-color" content={themeColor} />
<meta
  name="theme-color"
  media="(prefers-color-scheme: light)"
  content={themeColor}
/>
<meta
  name="theme-color"
  media="(prefers-color-scheme: dark)"
  content={themeColor}
/>
<link rel="sitemap" href="/sitemap-index.xml" />

<link rel="canonical" href={canonicalHref} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Krish Gupta" />

<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:site_name" content={siteName} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, shared.site)} />
<meta property="og:image:width" content={image.width.toString()} />
<meta property="og:image:height" content={image.height.toString()} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image.src, siteUrl)} />
<meta name="twitter:creator" content={`@${xHandle}`} />
<meta name="twitter:site" content={`@${xHandle}`} />

<Font cssVariable="--font-space-grotesk" />
<Font cssVariable="--font-inter-tight" />
<Font cssVariable="--font-inter" />
<Font cssVariable="--font-newsreader" preload />

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

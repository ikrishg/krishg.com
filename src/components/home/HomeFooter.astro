---
import {
  contactEmail,
  footerSocials,
  resumeHref,
} from "~site-links";
---

<footer
  class="home-footer relative z-[40] snap-start bg-[var(--home-closing-bg)] px-[var(--gutter)] pb-12 pt-4 text-[var(--home-closing-fg)]"
  data-home-nav-theme="closing"
>
  <div
    class="mx-auto flex w-full max-w-[var(--home-content-max)] flex-col items-center gap-8 text-center"
  >
    <a
      class="home-footer__resume min-h-11 py-2 font-[family-name:var(--font-space-grotesk),system-ui,sans-serif] text-[clamp(1.125rem,2vw,1.5rem)] font-medium lowercase tracking-[-0.02em] underline underline-offset-4 decoration-[1.5px] transition-opacity duration-150 ease-[var(--ease-out)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--home-closing-fg)] [@media(hover:hover)_and_(pointer:fine)]:hover:opacity-85"
      href={resumeHref}
    >
      résumé
    </a>

    <a
      class="home-footer__email inline-flex min-h-11 items-center gap-2.5 font-[family-name:var(--font-space-grotesk),system-ui,sans-serif] text-[clamp(1rem,1.8vw,1.25rem)] font-medium tracking-[-0.01em] transition-opacity duration-150 ease-[var(--ease-out)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--home-closing-fg)] [@media(hover:hover)_and_(pointer:fine)]:hover:opacity-85"
      href={`mailto:${contactEmail}`}
    >
      <svg
        class="h-[1.15em] w-[1.15em] shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 7.5 12 13l8-5.5M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
        ></path>
      </svg>
      <span>{contactEmail}</span>
    </a>

    <nav aria-label="Social links" class="home-footer__social">
      <ul class="m-0 flex list-none flex-wrap items-center justify-center gap-1 p-0">
        {
          footerSocials.map((social, index) => (
            <li class="inline-flex items-center">
              {index > 0 ? (
                <span
                  class="mx-2 select-none text-[var(--home-closing-fg)] opacity-55"
                  aria-hidden="true"
                >
                  ·
                </span>
              ) : null}
              <a
                class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm transition-opacity duration-150 ease-[var(--ease-out)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--home-closing-fg)] [@media(hover:hover)_and_(pointer:fine)]:hover:opacity-75"
                href={social.href}
                rel="noopener noreferrer"
                target="_blank"
                aria-label={social.label}
              >
                {social.id === "x" ? (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                    ></path>
                  </svg>
                ) : null}
                {social.id === "instagram" ? (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
                    ></path>
                  </svg>
                ) : null}
                {social.id === "linkedin" ? (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 114.126 0 2.063 2.063 0 01-2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                    ></path>
                  </svg>
                ) : null}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

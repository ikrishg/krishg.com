---
import KrishLogo from "./KrishLogo.astro";
import { navigations, socials } from "~shared";

const socialLinks = [
  { href: socials.x, label: "X" },
  { href: socials.instagram, label: "Instagram" },
  { href: socials.linkedin, label: "LinkedIn" },
  { href: socials.substack, label: "Substack" },
  { href: socials.github, label: "GitHub" },
  { href: socials.email, label: "Email" },
] as const;
---

<footer class="home-footer home-band-min-h snap-start" data-home-nav-theme="footer">
  <div class="home-footer__inner">
    <div class="home-footer__brand">
      <KrishLogo class="home-footer__logo" />
      <ul class="home-footer__social">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={
                  link.href.startsWith("mailto:")
                    ? undefined
                    : "noopener noreferrer"
                }
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="home-footer__copy">© 2026 Krish Gupta</p>
    </div>
    <nav class="home-footer__nav" aria-label="Site">
      {
        navigations.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  .home-footer {
    /*
     * Sticky + higher z-index so this cream band can cover the stacked
     * hero stickies and hand the navbar its footer theme.
     */
    position: sticky;
    top: var(--home-nav-height);
    z-index: 2;
    padding: 2.5rem var(--gutter) 2.75rem;
    background: var(--home-footer-bg);
    color: var(--home-footer-ink);
    display: flex;
    align-items: flex-end;
  }

  .home-footer__inner {
    width: 100%;
    max-width: var(--home-content-max);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem 3rem;
    padding-bottom: 0.5rem;
  }

  .home-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    min-width: min(100%, 18rem);
  }

  .home-footer :global(.home-footer__logo) {
    color: var(--home-footer-ink);
  }

  .home-footer :global(.home-footer__logo .home-logo__svg) {
    height: 2rem;
    width: auto;
  }

  .home-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .home-footer__social a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-block: 0.35rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.35s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .home-footer__social a:hover {
      opacity: 0.72;
    }
  }

  .home-footer__social a:active {
    opacity: 0.85;
  }

  .home-footer__copy {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 400;
    opacity: 0.9;
  }

  .home-footer__nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .home-footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-block: 0.35rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.2s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .home-footer__nav a:hover {
      opacity: 0.72;
    }
  }

  .home-footer__nav a:active {
    transform: scale(0.98);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-footer__social a,
    .home-footer__nav a {
      transition: none;
    }

    .home-footer__nav a:active {
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .home-footer__inner {
      flex-direction: column;
    }

    .home-footer__nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem 1.5rem;
    }
  }
</style>

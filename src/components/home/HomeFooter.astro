---
import {
  IconBrandInstagram,
  IconBrandLinkedin,
  IconBrandX,
  IconMail,
} from "@tabler/icons-react";
import { renderTablerIcon } from "~components/icons/tablerIcon";
import { contactEmail, footerSocials } from "~site-links";

const socialTablerIcons: Record<string, typeof IconBrandX> = {
  x: IconBrandX,
  linkedin: IconBrandLinkedin,
  instagram: IconBrandInstagram,
};

const mailIconHtml = renderTablerIcon(IconMail, {
  className: "home-footer__mail-icon shrink-0",
  stroke: 1.75,
});
---

<footer
  class="home-footer snap-start bg-[var(--home-closing-bg)] text-[var(--home-closing-fg)]"
  data-home-nav-theme="closing"
>
  <div class="home-footer__layout relative z-[46] px-[var(--gutter)]">
    <a
      class="home-footer__email group"
      href={`mailto:${contactEmail}`}
    >
      <Fragment set:html={mailIconHtml} />
      <span class="home-footer__email-text">{contactEmail}</span>
    </a>

    <nav aria-label="Social links" class="home-footer__social">
      <ul class="home-footer__social-list">
        {
          footerSocials.map((social) => {
            const Icon = socialTablerIcons[social.id];
            const iconHtml = Icon
              ? renderTablerIcon(Icon, {
                  className: "home-footer__social-icon",
                  size: 48,
                  stroke: 1.5,
                })
              : "";
            return (
              <li>
                <a
                  class="home-footer__social-link"
                  href={social.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  aria-label={`${social.label} (opens in new tab)`}
                >
                  <Fragment set:html={iconHtml} />
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</footer>

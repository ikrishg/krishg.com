---
import KrishLogo from "./KrishLogo.astro";
import HomeNavbarSearch from "./HomeNavbarSearch.tsx";
import HomeNavbarTheme from "./HomeNavbarTheme.tsx";
import HomeNavbarScroll from "./HomeNavbarScroll.tsx";
---

<header class="home-navbar">
  <div class="home-navbar__inner">
    <div class="home-navbar__spacer" aria-hidden="true"></div>
    <KrishLogo />
    <div class="home-navbar__actions">
      <HomeNavbarSearch client:load />
    </div>
  </div>
  <HomeNavbarTheme client:load />
  <HomeNavbarScroll client:load />
</header>

<style>
  /* Nav colors come from html[data-page-accent] → --home-nav-* */
  .home-navbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: var(--home-nav-bg);
    color: var(--home-nav-fg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-navbar {
      transition:
        background-color 0.45s ease,
        color 0.45s ease,
        box-shadow 0.38s ease;
    }
  }

  .home-navbar[data-scrolled="true"] {
    background-color: var(--home-nav-bg);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--home-nav-fg) 14%, transparent);
  }

  .home-navbar__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    max-width: var(--home-content-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    height: var(--home-nav-height);
  }

  .home-navbar__actions {
    display: flex;
    justify-content: flex-end;
  }

  .home-navbar :global(.home-logo) {
    color: var(--home-nav-logo);
  }

  @media (width < 768px) {
    .home-navbar :global(.home-navbar-search__panel) {
      position: fixed;
      top: var(--home-nav-height);
      right: var(--gutter);
      left: var(--gutter);
      width: auto;
      max-width: none;
    }
  }
</style>

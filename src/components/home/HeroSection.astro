---
import type { HeroAccent } from "./hero-types";

export interface Props {
  id: string;
  heading: string;
  subtext: string;
  accent: HeroAccent;
  ctaLabel: string;
  ctaHref: string;
  ctaExternal?: boolean;
  artifactFirst?: boolean;
  copyAlign?: "left" | "right";
}

const {
  id,
  heading,
  subtext,
  accent,
  ctaLabel,
  ctaHref,
  ctaExternal = false,
  artifactFirst = false,
  copyAlign = "left",
} = Astro.props;

const ctaRel = ctaExternal ? "noopener noreferrer" : undefined;
const ctaTarget = ctaExternal ? "_blank" : undefined;

---

<section
  id={id}
  data-home-nav-theme={accent}
  style={`--hero-bg:var(--home-${accent}-bg);--hero-fg:var(--home-${accent}-fg);`}
  aria-labelledby={`${id}-heading`}
  class:list={[
    /* Sticky parent stays transparent: Safari 26 Liquid Glass samples
       sticky/fixed background-color near the chrome. Band paint lives on
       an absolute child so stuck lower bands do not tint the toolbar. */
    "home-band-min-h sticky top-[var(--home-nav-height)] isolate snap-start flex items-center justify-center overflow-hidden box-border text-[var(--hero-fg)]",
    "py-8 md:py-14",
    "max-md:px-[var(--gutter)]",
  ]}
>
  <div
    class="hero-band-paint pointer-events-none absolute inset-0 -z-10"
    style="background-color: var(--hero-bg);"
    aria-hidden="true"
  >
  </div>
  <div
    class:list={[
      "relative z-[1] grid w-full max-w-[var(--home-content-max)] mx-auto px-[var(--gutter)] box-border min-w-0 h-full items-center gap-8",
      "max-md:px-0 max-md:gap-3",
      "md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-16",
    ]}
  >
    <div
      class:list={[
        "hero-copy order-2 flex flex-col justify-center max-md:items-center max-md:text-center",
        artifactFirst ? "md:order-2" : "md:order-1",
        copyAlign === "right"
          ? "md:items-end md:text-right"
          : "md:items-start md:text-left",
      ]}
    >
      <h2
        id={`${id}-heading`}
        class="m-0 font-[family-name:var(--font-inter-tight),var(--font-space-grotesk),system-ui,sans-serif] font-extrabold uppercase text-[var(--hero-fg)] leading-[0.92] tracking-[-0.045em] whitespace-normal text-[clamp(3.5rem,7.78vw,7rem)] max-md:text-[3.5rem] md:max-lg:whitespace-nowrap"
      >
        {heading}
      </h2>
      <p
        class="mt-3 mb-0 max-w-[36ch] font-[family-name:var(--font-space-grotesk),system-ui,sans-serif] font-normal text-[var(--hero-fg)] leading-snug text-[clamp(1.125rem,1.67vw,1.5rem)] max-md:max-w-[28ch]"
      >
        {subtext}
      </p>
      <a
        class="hero-cta inline-flex items-center mt-5 min-h-11 py-1.5 font-[family-name:var(--font-space-grotesk),system-ui,sans-serif] font-medium text-[var(--hero-fg)] underline underline-offset-4 decoration-[1.5px] text-[clamp(1.125rem,1.5vw,1.375rem)] transition-[opacity,transform] duration-[160ms] ease-[var(--ease-out)] active:scale-[0.98] motion-reduce:transition-none motion-reduce:active:scale-100 [@media(hover:hover)_and_(pointer:fine)]:hover:opacity-85"
        href={ctaHref}
        rel={ctaRel}
        target={ctaTarget}
      >
        {ctaLabel}
      </a>
    </div>
    <div
      class:list={[
        "hero-artifact order-1 relative flex h-80 min-h-80 w-full min-w-0 flex-1 flex-col items-center justify-center self-stretch overflow-visible md:h-full md:min-h-[var(--home-band-height)]",
        artifactFirst ? "md:order-1" : "md:order-2",
      ]}
    >
      <slot name="artifact" />
    </div>
  </div>
</section>
